{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CoinGecko Pro API Test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test",
        "--",
        "--testNamePattern=should normalize CoinGecko Pro API paths using OpenAPI spec",
        "--runInBand"
      ],
      "cwd": "${workspaceFolder}/packages/metrics-client",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
