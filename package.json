{
  "name": "universal-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\"",
    "test": "turbo run test",
    "clean:node_modules": "rm -rf node_modules && find examples -name node_modules -type d -exec rm -rf {} +",
    "clean": "turbo run clean && pnpm run clean:node_modules",
    "prerelease": "pnpm run build && pnpm run test && pnpm run lint",
    "publish:packages": "pnpm --filter \"./packages/*\" publish --access public --no-git-checks",
    "deploy": "pnpm run prerelease && pnpm run publish:packages"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  }
}
