{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-cjs",
    "module": "CommonJS",
    "moduleResolution": "node",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-cjs", "**/*.test.ts", "src/__tests__/**/*"]
}