{
  "name": "@universal-kit/metrics-client",
  "version": "0.1.3",
  "description": "OpenTelemetry-based metrics HTTP client wrapper with API provider monitoring and enhanced tracing",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinbangyi/universal-kit.git",
    "directory": "packages/metrics-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "http",
    "client",
    "axios",
    "metrics",
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "api-monitoring",
    "provider-metrics"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@universal-kit/logger": "workspace:^0.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "axios": "^1.13.1"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "node-fetch": "^3.3.0",
    "@types/node": "^20.0.0",
    "@nestjs/testing": "^10.0.0",
    "rxjs": "^7.8.0"
  }
}